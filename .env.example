# ==============================================================================
# AssetAudit (assetaudit.uz) — Muhit O'zgaruvchilari Namunasi (.env.example)
# Haqiqiy maxfiy qiymatlarni .env.local yoki .env.production faylida saqlang
# ==============================================================================

# 1. PostgreSQL Ma'lumotlar Bazasi (Eskiz VPS / Mustaqil PostgreSQL 18)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
DATABASE_URL=postgresql://postgres:parol_bu_yerda@127.0.0.1:5432/assetaudit_db
DATABASE_SSL=false

# 2. Better Auth Xavfsizlik Sozlamalari
# Qat'iy talab: Kamida 32 belgili kriptografik kalit (Linux terminalida: openssl rand -base64 32)
BETTER_AUTH_SECRET=yuqori_entropiyali_kamida_32_belgili_maxfiy_kalit_bu_yerda
# Rasmiy domen manzili (Productionda https://assetaudit.uz, Lokalda http://localhost:3001)
BETTER_AUTH_URL=https://assetaudit.uz

# 3. Public QR Kodlar va Stikerlar uchun Doimiy Domen
# Agar ko'rsatilmasa, BETTER_AUTH_URL qiymatidan foydalaniladi
NEXT_PUBLIC_APP_URL=https://assetaudit.uz

# 4. Doimiy Fayl Saqlash Jildi (Persistent Storage)
# Server yangilanganda rasmlar yo'qolib ketmasligi uchun alohida jild yo'li
# VPS Linux: /var/lib/assetaudit/uploads
# Lokal Windows: public/uploads/inventory
UPLOAD_STORAGE_DIR=/var/lib/assetaudit/uploads

# 5. Xavfsizlik va Rate Limiter
# Avtomatlashtirilgan testlarda false, ishlab chiqarish (production) muhitida true bo'lishi shart
RATE_LIMIT_ENABLED=true

# 6. Standalone Node.js Ishlab Chiqarish Porti
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
