{
  "name": "assetaudit.uz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "package": "npm run build && tsx scripts/package-release.ts",
    "db:generate": "drizzle-kit generate",
    "db:clean": "tsx scripts/reset-test-data.ts",
    "pretest": "node -e \"const fs=require('fs'); if (!fs.existsSync('.env.test') && fs.existsSync('.env.test.example')) { fs.copyFileSync('.env.test.example', '.env.test'); console.log('[pretest] .env.test yaratildi (.env.test.example asosida)'); }\"",
    "test": "tsx --conditions=react-server --env-file=.env.test --test src/lib/auth/__tests__/**/*.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.4",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.56.0",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.3",
    "typescript": "^5"
  }
}
