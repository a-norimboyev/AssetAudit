# ==============================================================================
# AssetAudit (assetaudit.uz) — Production Environment Template
# Ushbu fayldan nusxa olib, VPS da /var/www/assetaudit/.env.production nomi bilan saqlang:
#   chmod 600 /var/www/assetaudit/.env.production
#   chown assetaudit:assetaudit /var/www/assetaudit/.env.production
# ==============================================================================

# 1. PostgreSQL Production Ma'lumotlar Bazasi
# Eskiz VPS da PostgreSQL 5432-portda ishlaydi:
DATABASE_URL=postgresql://mulknazorat_app:STRONG_GENERATED_PASSWORD@127.0.0.1:5432/mulknazorat
DATABASE_SSL=false

# 2. Better Auth Xavfsizlik Kaliti
# Linux terminalida quyidagi buyruq orqali yangi kalit oling:
#   openssl rand -base64 36
BETTER_AUTH_SECRET=REPLACE_WITH_OPENSSL_RANDOM_36_CHARS_STRING

# Rasmiy HTTPS Domen
BETTER_AUTH_URL=https://assetaudit.uz
NEXT_PUBLIC_APP_URL=https://assetaudit.uz

# 3. Persistent Media Storage va Nginx X-Accel Himoyasi
UPLOAD_STORAGE_DIR=/var/lib/assetaudit/uploads
USE_X_ACCEL=true

# 4. Xavfsizlik va Tezlik Cheklovlari
RATE_LIMIT_ENABLED=true
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1
